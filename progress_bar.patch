@@ -0,0 +1,22 @@
+package org.odk.collect.android.utilities
+
+import android.graphics.Typeface
+import android.text.SpannableString
+import android.text.Spanned
+import android.text.style.StyleSpan
+
+/** Makes the given pieces of [text] bold (each piece wherever it first appears). */
+object BoldText {
+    @JvmStatic
+    fun of(text: String, vararg pieces: String): CharSequence {
+        val spannable = SpannableString(text)
+        for (piece in pieces) {
+            if (piece.isEmpty()) continue
+            val start = text.indexOf(piece)
+            if (start >= 0) {
+                spannable.setSpan(StyleSpan(Typeface.BOLD), start, start + piece.length, Spanned.SPAN_EXCLUSIVE_EXCLUSIVE)
+            }
+        }
+        return spannable
+    }
+}
diff --git a/collect_app/src/main/java/org/odk/collect/android/utilities/ConstellationDrawable.kt b/collect_app/src/main/java/org/odk/collect/android/utilities/ConstellationDrawable.kt
new file mode 100644
index 0000000..15eafd2
--- /dev/null
+++ b/collect_app/src/main/java/org/odk/collect/android/utilities/ConstellationDrawable.kt
@@ -0,0 +1,93 @@
+package org.odk.collect.android.utilities
+
+import android.content.Context
+import android.graphics.Bitmap
+import android.graphics.BitmapShader
+import android.graphics.Canvas
+import android.graphics.ColorFilter
+import android.graphics.Paint
+import android.graphics.Path
+import android.graphics.PixelFormat
+import android.graphics.RectF
+import android.graphics.Shader
+import android.graphics.DashPathEffect
+import android.graphics.drawable.Drawable
+import androidx.core.graphics.ColorUtils
+
+/**
+ * A very faint scatter of tiny people joined by dotted lines ("constellation of people"), repeated
+ * to fill the screen. It is painted once into a small tile and then repeated, so scrolling stays
+ * smooth. Colours are taken from the design tints; strength is set by [strength] (0..1).
+ */
+class ConstellationDrawable(context: Context, private val strength: Float = 1f) : Drawable() {
+    private val density = context.resources.displayMetrics.density
+    private val paint = Paint(Paint.ANTI_ALIAS_FLAG)
+    private val tile: Bitmap
+
+    // Tile size in dp and the people in it (x, y, tint index, scale).
+    private val tileW = 180
+    private val tileH = 190
+    private val people = listOf(
+        Triple(30f, 34f, 0), Triple(98f, 20f, 1), Triple(150f, 70f, 0), Triple(88f, 96f, 2),
+        Triple(34f, 128f, 0), Triple(142f, 150f, 3), Triple(100f, 164f, 0)
+    )
+    private val links = listOf(0 to 1, 1 to 2, 1 to 3, 3 to 4, 3 to 5, 2 to 5, 5 to 6, 3 to 6)
+
+    init {
+        val tints = listOf(DesignTint.GREEN, DesignTint.SKY, DesignTint.SAND, DesignTint.LILAC)
+        val colors = tints.map { it.fg(context) }
+        val w = (tileW * density).toInt().coerceAtLeast(1)
+        val h = (tileH * density).toInt().coerceAtLeast(1)
+        tile = Bitmap.createBitmap(w, h, Bitmap.Config.ARGB_8888)
+        val c = Canvas(tile)
+        c.scale(density, density)
+
+        val line = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+            style = Paint.Style.STROKE
+            strokeWidth = 1f
+            strokeCap = Paint.Cap.ROUND
+            pathEffect = DashPathEffect(floatArrayOf(2f, 4f), 0f)
+            color = ColorUtils.setAlphaComponent(colors[0], (0.16f * 255 * strength).toInt())
+        }
+        for ((a, b) in links) {
+            c.drawLine(people[a].first, people[a].second, people[b].first, people[b].second, line)
+        }
+
+        people.forEachIndexed { i, (x, y, tintIndex) ->
+            val s = if (i % 2 == 1) 1.0f else 1.15f
+            val color = colors[tintIndex]
+            val fill = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+                style = Paint.Style.FILL
+                this.color = ColorUtils.setAlphaComponent(color, (0.17f * 255 * strength).toInt())
+            }
+            val stroke = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+                style = Paint.Style.STROKE
+                strokeWidth = 1.3f
+                strokeCap = Paint.Cap.ROUND
+                this.color = ColorUtils.setAlphaComponent(color, (0.26f * 255 * strength).toInt())
+            }
+            c.drawCircle(x, y - 4f * s, 3.1f * s, fill)
+            c.drawCircle(x, y - 4f * s, 3.1f * s, stroke)
+            val r = 6.4f * s
+            val shoulders = Path().apply { arcTo(RectF(x - r, y + 7f * s - r, x + r, y + 7f * s + r), 180f, 180f) }
+            c.drawPath(shoulders, stroke)
+        }
+
+        paint.shader = BitmapShader(tile, Shader.TileMode.REPEAT, Shader.TileMode.REPEAT)
+    }
+
+    override fun draw(canvas: Canvas) {
+        canvas.drawRect(bounds, paint)
+    }
+
+    override fun setAlpha(alpha: Int) {
+        paint.alpha = alpha
+    }
+
+    override fun setColorFilter(colorFilter: ColorFilter?) {
+        paint.colorFilter = colorFilter
+    }
+
+    @Deprecated("Deprecated in Java")
+    override fun getOpacity(): Int = PixelFormat.TRANSLUCENT
+}
diff --git a/collect_app/src/main/java/org/odk/collect/android/utilities/DesignChrome.kt b/collect_app/src/main/java/org/odk/collect/android/utilities/DesignChrome.kt
