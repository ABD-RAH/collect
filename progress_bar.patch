@@ -0,0 +1,57 @@
+package org.odk.collect.android.utilities
+
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.ColorFilter
+import android.graphics.PixelFormat
+import android.graphics.drawable.Drawable
+import androidx.appcompat.content.res.AppCompatResources
+import org.odk.collect.android.R
+
+/**
+ * The faint ring of people, drawn centred at a fixed size inside whatever bounds it is given.
+ * It deliberately has no size of its own, so putting it behind a view never makes that view taller.
+ */
+class RingDrawable(context: Context, sizeDp: Float, private val strength: Float) : Drawable() {
+    private val density = context.resources.displayMetrics.density
+    private val sizePx = (sizeDp * density).toInt()
+    private val ring: Drawable = AppCompatResources.getDrawable(context, R.drawable.ic_people_ring)!!.mutate()
+
+    /**
+     * Height at the top of the bounds that is covered by the status bar. The ring is centred in the
+     * space below it, which is where the header's content actually sits.
+     */
+    var topInsetPx: Int = 0
+        set(value) {
+            field = value
+            invalidateSelf()
+        }
+
+    /** If set, the ring is centred at this height (in the bounds' own coordinates) instead. */
+    var centerYPx: Int? = null
+        set(value) {
+            field = value
+            invalidateSelf()
+        }
+
+    override fun draw(canvas: Canvas) {
+        val b = bounds
+        val usableHeight = b.height() - topInsetPx
+        // Never draw bigger than the space available, so the ring is never cut off by the header.
+        val margin = (2 * density).toInt()
+        val size = minOf(sizePx, usableHeight - margin * 2, b.width() - margin * 2).coerceAtLeast(0)
+        if (size == 0) return
+        val left = b.left + (b.width() - size) / 2
+        val top = centerYPx?.let { b.top + it - size / 2 } ?: (b.top + topInsetPx + (usableHeight - size) / 2)
+        ring.setBounds(left, top, left + size, top + size)
+        ring.alpha = (strength * 255).toInt().coerceIn(0, 255)
+        ring.draw(canvas)
+    }
+
+    override fun setAlpha(alpha: Int) {}
+
+    override fun setColorFilter(colorFilter: ColorFilter?) {}
+
+    @Deprecated("Deprecated in Java")
+    override fun getOpacity(): Int = PixelFormat.TRANSLUCENT
+}
