+package org.odk.collect.android.formentry
+
+import org.javarosa.core.model.FormIndex
+import org.javarosa.core.model.instance.TreeElement
+import org.javarosa.form.api.FormEntryController
+import org.odk.collect.android.javarosawrapper.FormController
+import timber.log.Timber
+
+/**
+ * Collect never removes repeat instances when a repeat_count gets smaller (a known JavaRosa
+ * limitation), so lowering the household count left the old number of member screens.
+ *
+ * After every forward move, this checks the household count against the member repeats and
+ * deletes the surplus instances from the end. Adding instances when the count goes up is done
+ * by the form engine itself when the user steps forward.
+ *
+ * Only forms that have a "household_headcount" question and the repeats named below are affected.
+ */
+object RepeatSync {
+    private const val COUNT_FIELD = "household_headcount"
+    private val REPEATS = listOf("family_members", "member_drilldown")
+
+    /** Members that would be removed if the household count were applied now. */
+    data class Surplus(val newCount: Int, val names: List<String>, val countIndex: FormIndex?)
+
+    /**
+     * Returns what would be removed, or null if the member repeats already match the count.
+     * Nothing is changed.
+     */
+    @JvmStatic
+    fun surplus(formController: FormController): Surplus? {
+        val original = formController.getFormIndex()
+        return try {
+            val root = formController.getFormDef()?.mainInstance?.root ?: return null
+            val count = readCount(root) ?: return null
+            val existing = countInstances(root, "family_members")
+            if (count < 1 || existing <= count) {
+                return null
+            }
+            val text = SurveyText.forLanguage(formController.getLanguage())
+            val entered = RosterTable.memberNames(formController)
+            val names = (count until existing).map { k ->
+                entered.getOrNull(k)?.takeIf { it.isNotBlank() } ?: text.member(k + 1)
+            }
+            Surplus(count, names, findCountQuestion(formController))
+        } catch (e: RuntimeException) {
+            null
+        } finally {
+            try {
+                formController.jumpToIndex(original)
+            } catch (e: RuntimeException) {
+                // ignore
+            }
+        }
+    }
+
+    private fun findCountQuestion(formController: FormController): FormIndex? {
+        formController.jumpToIndex(FormIndex.createBeginningOfFormIndex())
+        var event = formController.stepToNextEvent(true)
+        while (event != FormEntryController.EVENT_END_OF_FORM) {
+            if (event == FormEntryController.EVENT_QUESTION &&
+                formController.getFormIndex().reference?.nameLast == COUNT_FIELD
+            ) {
+                return formController.getFormIndex()
+            }
+            event = formController.stepToNextEvent(true)
+        }
+        return null
+    }
+
+    @JvmStatic
+    fun trim(formController: FormController) {
+        val original = formController.getFormIndex()
+        try {
+            val root = formController.getFormDef()?.mainInstance?.root ?: return
+            val count = readCount(root) ?: return
+            if (count < 1 || REPEATS.none { countInstances(root, it) > count }) {
+                return
+            }
+
+            formController.jumpToIndex(FormIndex.createBeginningOfFormIndex())
+            val targets = LinkedHashMap<Pair<String, Int>, FormIndex>()
+            var event = formController.stepToNextEvent(true)
+            while (event != FormEntryController.EVENT_END_OF_FORM) {
+                val reference = formController.getFormIndex().reference
+                if (reference != null) {
+                    for (i in 0 until reference.size()) {
+                        val name = reference.getName(i)
+                        if (name in REPEATS) {
+                            val position = reference.getMultiplicity(i)
+                            if (position >= count) {
+                                targets.putIfAbsent(Pair(name, position), formController.getFormIndex())
+                            }
+                        }
+                    }
+                }
+                event = formController.stepToNextEvent(true)
+            }
+
+            // Highest position first so the positions of the others do not shift.
+            for ((key, index) in targets.entries.sortedByDescending { it.key.second }) {
+                formController.jumpToIndex(index)
+                formController.deleteRepeat()
+                Timber.i("Removed surplus %s instance %d (household count is %d)", key.first, key.second + 1, count)
+            }
+        } catch (e: RuntimeException) {
+            Timber.e(e, "Could not remove surplus member repeats")
+        } finally {
+            try {
+                formController.jumpToIndex(original)
+            } catch (e: RuntimeException) {
+                // The old position may have been inside a removed instance; the caller refreshes.
+            }
+        }
+    }
+
+    private fun readCount(root: TreeElement): Int? {
+        val field = find(root, COUNT_FIELD) ?: return null
+        return field.value?.displayText?.trim()?.toIntOrNull()
+    }
+
+    private fun find(element: TreeElement, name: String): TreeElement? {
+        for (i in 0 until element.numChildren) {
+            val child = element.getChildAt(i)
+            if (child.name == name) return child
+            val deeper = find(child, name)
+            if (deeper != null) return deeper
+        }
+        return null
+    }
+
+    private fun countInstances(element: TreeElement, name: String): Int {
+        var total = 0
+        for (i in 0 until element.numChildren) {
+            val child = element.getChildAt(i)
+            total += if (child.name == name) {
+                if (child.multiplicity >= 0) 1 else 0
+            } else {
+                countInstances(child, name)
+            }
+        }
+        return total
+    }
+}
diff --git a/collect_app/src/main/java/org/odk/collect/android/formentry/RosterTable.kt b/collect_app/src/main/java/org/odk/collect/android/formentry/RosterTable.kt
