@@ -0,0 +1,19 @@
+package org.odk.collect.android.mainmenu
+
+import kotlin.math.abs
+
+object ProjectNameFormat {
+    /**
+     * Splits a project name onto two lines at the space nearest the middle, so
+     * "Community Survey PoC" becomes "Community" / "Survey PoC". A single word stays on one line.
+     */
+    @JvmStatic
+    fun twoLines(name: String): String {
+        val trimmed = name.trim()
+        val spaces = trimmed.indices.filter { trimmed[it] == ' ' }
+        if (spaces.isEmpty()) return trimmed
+        val middle = trimmed.length / 2.0
+        val best = spaces.minByOrNull { abs(it - middle) } ?: return trimmed
+        return trimmed.substring(0, best).trim() + "\n" + trimmed.substring(best + 1).trim()
+    }
+}
diff --git a/collect_app/src/main/java/org/odk/collect/android/milestones/HouseholdCompleteActivity.kt b/collect_app/src/main/java/org/odk/collect/android/milestones/HouseholdCompleteActivity.kt
