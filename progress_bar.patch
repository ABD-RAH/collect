@@ -0,0 +1,56 @@
+package org.odk.collect.android.formentry
+
+import android.content.Context
+import android.view.View
+import android.widget.TextView
+import org.odk.collect.android.R
+import org.odk.collect.android.utilities.BoldText
+
+/**
+ * A plain help card on the very first page of the form telling the surveyor how to switch to
+ * Malayalam. It is only shown when the form has a Malayalam language, the form is not already in
+ * it, the language menu is allowed, and the card has not been closed. Closing it hides it for good.
+ */
+object LanguageHint {
+    private const val PREFS = "ui_hints"
+    private const val KEY_DISMISSED = "language_hint_dismissed"
+
+    /** The form's own name for Malayalam (as listed in the Change Language dialog), if it has one. */
+    private fun malayalam(languages: Array<String>?): String? =
+        languages?.firstOrNull { it.contains("malayalam", ignoreCase = true) || it.trim().endsWith("(ml)", ignoreCase = true) }
+
+    @JvmStatic
+    fun update(
+        card: View?,
+        languages: Array<String>?,
+        currentLanguage: String?,
+        canChangeLanguage: Boolean,
+        state: StageProgress.State
+    ) {
+        if (card == null) return
+        val context = card.context
+        val target = malayalam(languages)
+        val onFirstPage = !state.atEnd && state.current == 0 && (state.stages.firstOrNull()?.position ?: 0) <= 1
+        val show = onFirstPage &&
+            canChangeLanguage &&
+            target != null &&
+            languages != null && languages.size > 1 &&
+            currentLanguage != target &&
+            !context.getSharedPreferences(PREFS, Context.MODE_PRIVATE).getBoolean(KEY_DISMISSED, false)
+
+        if (!show) {
+            card.visibility = View.GONE
+            return
+        }
+
+        val menuName = context.getString(org.odk.collect.strings.R.string.change_language)
+        card.findViewById<TextView>(R.id.hint_title).setText(R.string.language_hint_title)
+        card.findViewById<TextView>(R.id.hint_body).text =
+            BoldText.of(context.getString(R.string.language_hint_body, menuName, target), menuName, target!!)
+        card.findViewById<View>(R.id.hint_close).setOnClickListener {
+            context.getSharedPreferences(PREFS, Context.MODE_PRIVATE).edit().putBoolean(KEY_DISMISSED, true).apply()
+            card.visibility = View.GONE
+        }
+        card.visibility = View.VISIBLE
+    }
+}
