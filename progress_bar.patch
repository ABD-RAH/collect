+@Composable
+private fun ReviewList(
+    review: List<StageProgress.ReviewRow>,
+    completeWord: String,
+    goWord: String,
+    onGoTo: (FormIndex) -> Unit
+) {
+    var expanded by remember { mutableStateOf(setOf<Int>()) }
+    val ok = colorResource(R.color.dc_action_mid)
+    val bad = colorResource(R.color.dc_alert)
+    val okBackground = colorResource(R.color.dc_ok_bg)
+    val badBackground = colorResource(R.color.dc_alert_bg)
+    val hairline = colorResource(R.color.dc_hairline)
+    val deep = colorResource(R.color.dc_deep)
+    val cardShape = RoundedCornerShape(dimensionResource(R.dimen.dc_radius_card))
+
+    Column(
+        modifier = Modifier.padding(top = marginStandard()),
+        verticalArrangement = Arrangement.spacedBy(marginSmall())
+    ) {
+        review.forEachIndexed { i, row ->
+            val complete = row.answered >= row.total
+            val color = if (complete) ok else bad
+            val fraction = if (row.total <= 0) 1f else (row.answered.toFloat() / row.total).coerceIn(0f, 1f)
+            val open = i in expanded
+            // Each row gets its own soft tint so the stages are easy to tell apart.
+            val tint = org.odk.collect.android.utilities.DesignTint.cycle(i)
+            val tintBg = colorResource(tint.background)
+            val tintBorder = colorResource(tint.border)
+            val tintFg = colorResource(tint.foreground)
+
+            Card(
+                modifier = Modifier
+                    .fillMaxWidth()
+                    .clickable { expanded = if (open) expanded - i else expanded + i },
+                shape = cardShape,
+                colors = CardDefaults.cardColors(containerColor = Color.White),
+                border = BorderStroke(1.dp, hairline),
+                elevation = CardDefaults.cardElevation(defaultElevation = 3.dp)
+            ) {
+                Column(modifier = Modifier.padding(marginStandard())) {
+                    Row(
+                        modifier = Modifier.fillMaxWidth(),
+                        verticalAlignment = Alignment.CenterVertically,
+                        horizontalArrangement = Arrangement.SpaceBetween
+                    ) {
+                        Box(
+                            modifier = Modifier
+                                .padding(end = marginSmall())
+                                .size(34.dp)
+                                .clip(CircleShape)
+                                .background(tintBg)
+                                .border(1.dp, tintBorder, CircleShape),
+                            contentAlignment = Alignment.Center
+                        ) {
+                            Image(
+                                painter = painterResource(row.iconRes),
+                                contentDescription = null,
+                                colorFilter = ColorFilter.tint(tintFg),
+                                modifier = Modifier.size(18.dp)
+                            )
+                        }
+                        Text(
+                            text = row.label,
+                            style = MaterialTheme.typography.titleMedium,
+                            modifier = Modifier.weight(1f)
+                        )
+                        Text(
+                            text = "${row.answered}/${row.total} $completeWord",
+                            color = color,
+                            fontWeight = FontWeight.Bold,
+                            style = MaterialTheme.typography.bodyMedium
+                        )
+                        Icon(
+                            imageVector = when {
+                                complete -> Icons.Default.Check
+                                open -> Icons.Default.KeyboardArrowDown
+                                else -> Icons.AutoMirrored.Filled.KeyboardArrowRight
+                            },
+                            tint = color,
+                            contentDescription = null,
+                            modifier = Modifier.padding(start = marginExtraSmall())
+                        )
+                    }
+
+                    Box(
+                        modifier = Modifier
+                            .padding(top = marginExtraSmall())
+                            .fillMaxWidth()
+                            .height(5.dp)
+                            .clip(RoundedCornerShape(3.dp))
+                            .background(hairline)
+                    ) {
+                        Box(
+                            modifier = Modifier
+                                .fillMaxWidth(fraction)
+                                .fillMaxHeight()
+                                .background(color)
+                        )
+                    }
+
+                    if (open) {
+                        row.items.forEach { item ->
+                            val itemColor = if (item.answered) ok else bad
+                            Row(
+                                modifier = Modifier
+                                    .padding(top = marginExtraSmall())
+                                    .fillMaxWidth()
+                                    .clip(RoundedCornerShape(10.dp))
+                                    .background(if (item.answered) okBackground else badBackground)
+                                    .clickable { onGoTo(item.index) }
+                                    .padding(marginSmall()),
+                                verticalAlignment = Alignment.CenterVertically
+                            ) {
+                                Icon(
+                                    imageVector = if (item.answered) Icons.Default.Check else Icons.Default.Close,
+                                    tint = itemColor,
+                                    contentDescription = null,
+                                    modifier = Modifier.padding(end = marginSmall())
+                                )
+                                Text(
+                                    text = item.text,
+                                    modifier = Modifier.weight(1f),
+                                    style = MaterialTheme.typography.bodyMedium,
+                                    fontWeight = if (item.answered) FontWeight.Normal else FontWeight.Bold
+                                )
+                                if (!item.answered) {
+                                    Text(text = goWord, color = bad, fontWeight = FontWeight.Bold)
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
