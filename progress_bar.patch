@@ -0,0 +1,42 @@
+package org.odk.collect.android.utilities
+
+import android.content.Context
+import android.graphics.drawable.GradientDrawable
+import androidx.annotation.ColorRes
+import androidx.core.content.ContextCompat
+import org.odk.collect.android.R
+
+/**
+ * The soft secondary colours (see design_tokens.xml). A tint is three colours: badge background,
+ * badge border and the foreground used for the icon or text on it.
+ */
+enum class DesignTint(
+    @ColorRes val background: Int,
+    @ColorRes val border: Int,
+    @ColorRes val foreground: Int
+) {
+    GREEN(R.color.dc_mist, R.color.dc_hairline, R.color.dc_deep),
+    SKY(R.color.dc_sky_bg, R.color.dc_sky_bd, R.color.dc_sky_fg),
+    SAND(R.color.dc_sand_bg, R.color.dc_sand_bd, R.color.dc_sand_fg),
+    LILAC(R.color.dc_lilac_bg, R.color.dc_lilac_bd, R.color.dc_lilac_fg),
+    CORAL(R.color.dc_coral_bg, R.color.dc_coral_bd, R.color.dc_coral_fg);
+
+    fun fg(context: Context): Int = ContextCompat.getColor(context, foreground)
+    fun bg(context: Context): Int = ContextCompat.getColor(context, background)
+    fun bd(context: Context): Int = ContextCompat.getColor(context, border)
+
+    /** A round badge background in this tint. */
+    fun badge(context: Context, strokeDp: Float = 1f): GradientDrawable {
+        return GradientDrawable().apply {
+            shape = GradientDrawable.OVAL
+            setColor(bg(context))
+            setStroke((strokeDp * context.resources.displayMetrics.density).toInt().coerceAtLeast(1), bd(context))
+        }
+    }
+
+    companion object {
+        /** Tints handed out to rows in turn, so neighbouring rows differ. */
+        @JvmStatic
+        fun cycle(index: Int): DesignTint = entries[index.mod(entries.size)]
+    }
+}
