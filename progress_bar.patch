+package org.odk.collect.android.formentry
+
+import android.content.Context
+import android.graphics.Color
+import android.graphics.Typeface
+import android.graphics.drawable.GradientDrawable
+import android.view.Gravity
+import android.view.View
+import android.widget.FrameLayout
+import android.widget.ImageView
+import android.widget.LinearLayout
+import android.widget.TextView
+import androidx.annotation.ColorInt
+import androidx.annotation.DrawableRes
+import androidx.core.content.ContextCompat
+import org.javarosa.core.model.FormIndex
+import org.odk.collect.android.R
+
+/**
+ * Draws the stage header at the top of the form screen: section icon, title and "Stage n of N", a
+ * row of equal-width segments (the current one filled in proportion to progress through that
+ * stage), and a row with "Previous: <stage>" (tappable), the current stage, and a dimmed
+ * "Next: <stage>". There is deliberately no way to go forward from here.
+ *
+ * The header continues the colour of the toolbar above it (see DesignChrome) so the two look like
+ * one block. Every colour and radius comes from design_tokens.xml.
+ */
+object StageHeader {
+    private class Palette(context: Context) {
+        @ColorInt val onHero = ContextCompat.getColor(context, R.color.dc_on_hero)
+        @ColorInt val onHeroMuted = ContextCompat.getColor(context, R.color.dc_on_hero_muted)
+        @ColorInt val track = ContextCompat.getColor(context, R.color.dc_hero_track)
+        @ColorInt val outline = ContextCompat.getColor(context, R.color.dc_hero_outline)
+        @ColorInt val glass = ContextCompat.getColor(context, R.color.dc_hero_glass)
+        @ColorInt val deep = ContextCompat.getColor(context, R.color.dc_deep)
+    }
+
+    @JvmStatic
+    fun render(
+        holder: LinearLayout,
+        title: String,
+        section: String?,
+        state: StageProgress.State,
+        @DrawableRes iconRes: Int,
+        onPrevious: (FormIndex) -> Unit
+    ) {
+        val context = holder.context
+        val palette = Palette(context)
+        val density = context.resources.displayMetrics.density
+        fun dp(v: Int) = (v * density).toInt()
+
+        holder.removeAllViews()
+        holder.orientation = LinearLayout.VERTICAL
+        holder.setPadding(dp(20), dp(0), dp(20), dp(14))
+        holder.background = org.odk.collect.android.utilities.DesignChrome.heroBackground(context, 170f)
+
+        val stages = state.stages
+        val index = state.current
+
+        // Row 1: icon badge, title and "Stage n of N"
+        holder.addView(LinearLayout(context).apply {
+            orientation = LinearLayout.HORIZONTAL
+            gravity = Gravity.CENTER_VERTICAL
+            addView(badge(context, iconRes, palette, dp(30), dp(18)))
+            addView(text(context, title, 15.5f, palette.onHero, true).apply {
+                maxLines = 1
+                ellipsize = android.text.TextUtils.TruncateAt.END
+                layoutParams = LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.WRAP_CONTENT, 1f).apply {
+                    marginStart = dp(10)
+                    marginEnd = dp(8)
+                }
+            })
+            addView(text(context, state.text.stage(index + 1, stages.size), 12f, palette.onHeroMuted, true))
+        })
+
+        // Row 2: equal segments
+        holder.addView(LinearLayout(context).apply {
+            orientation = LinearLayout.HORIZONTAL
+            layoutParams = LinearLayout.LayoutParams(
+                LinearLayout.LayoutParams.MATCH_PARENT, dp(6)
+            ).apply { topMargin = dp(10) }
+            stages.forEachIndexed { i, stage ->
+                val fraction = when {
+                    i < index -> 1f
+                    i == index -> stage.fraction
+                    else -> 0f
+                }
+                addView(segment(context, fraction, dp(3), palette).apply {
+                    layoutParams = LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.MATCH_PARENT, 1f).apply {
+                        if (i > 0) marginStart = dp(4)
+                    }
+                })
+            }
+        })
+
+        // Row 3: previous / current / next
+        holder.addView(LinearLayout(context).apply {
+            orientation = LinearLayout.HORIZONTAL
+            gravity = Gravity.CENTER_VERTICAL
+            layoutParams = LinearLayout.LayoutParams(
+                LinearLayout.LayoutParams.MATCH_PARENT, LinearLayout.LayoutParams.WRAP_CONTENT
+            ).apply { topMargin = dp(10) }
+
+            val previous = stages.getOrNull(index - 1)
+            val next = stages.getOrNull(index + 1)
+
+            addView(pill(context, if (previous != null) "‹ ${state.text.previous}\n${previous.label}" else "", 11f, palette.onHero, false).apply {
+                layoutParams = LinearLayout.LayoutParams(0, dp(38), if (section.isNullOrBlank()) 1.3f else 0.9f)
+                if (previous == null) {
+                    visibility = View.INVISIBLE
+                } else {
+                    background = outline(dp(19).toFloat(), palette.outline, dp(1), false, density)
+                    val target = previous.first
+                    if (target != null) {
+                        setOnClickListener { onPrevious(target) }
+                    } else {
+                        alpha = 0.5f
+                    }
+                }
+            })
+            addView(pill(context, stages[index].label, 14.5f, palette.deep, true).apply {
+                if (!section.isNullOrBlank()) {
+                    // Person / stage, then the section being filled in beside it on the same line.
+                    val spannable = android.text.SpannableStringBuilder(stages[index].label)
+                    spannable.setSpan(android.text.style.StyleSpan(Typeface.BOLD), 0, spannable.length, 0)
+                    val start = spannable.length
+                    spannable.append(" · ").append(section)
+                    spannable.setSpan(android.text.style.RelativeSizeSpan(0.8f), start, spannable.length, 0)
+                    spannable.setSpan(android.text.style.StyleSpan(Typeface.NORMAL), start, spannable.length, 0)
+                    text = spannable
+                    maxLines = 1
+                }
+                layoutParams = LinearLayout.LayoutParams(0, dp(38), if (section.isNullOrBlank()) 0.9f else 1.6f).apply {
+                    marginStart = dp(6)
+                    marginEnd = dp(6)
+                }
+                background = GradientDrawable().apply {
+                    setColor(palette.onHero)
+                    cornerRadius = dp(19).toFloat()
+                }
+                elevation = 2f * density
+            })
+            addView(pill(context, if (next != null) "${state.text.next} ›\n${next.label}" else "", 11f, palette.onHeroMuted, false).apply {
+                layoutParams = LinearLayout.LayoutParams(0, dp(38), if (section.isNullOrBlank()) 1.3f else 0.9f)
+                gravity = Gravity.CENTER_VERTICAL or Gravity.END
+                if (next == null) {
+                    visibility = View.INVISIBLE
+                } else {
+                    background = outline(dp(19).toFloat(), palette.outline, dp(1), true, density)
+                    isClickable = false
+                }
+            })
+        })
+    }
+
+    private fun badge(context: Context, @DrawableRes iconRes: Int, palette: Palette, size: Int, iconSize: Int): View {
+        return FrameLayout(context).apply {
+            layoutParams = LinearLayout.LayoutParams(size, size)
+            background = GradientDrawable().apply {
+                shape = GradientDrawable.OVAL
+                setColor(palette.glass)
+                setStroke(1, palette.outline)
+            }
+            addView(ImageView(context).apply {
+                setImageResource(iconRes)
+                importantForAccessibility = View.IMPORTANT_FOR_ACCESSIBILITY_NO
+            }, FrameLayout.LayoutParams(iconSize, iconSize, Gravity.CENTER))
+        }
+    }
+
+    private fun text(context: Context, value: String, size: Float, @ColorInt color: Int, bold: Boolean): TextView {
+        return TextView(context).apply {
+            text = value
+            textSize = size
+            setTextColor(color)
+            if (bold) setTypeface(typeface, Typeface.BOLD)
+        }
+    }
+
+    private fun pill(context: Context, value: String, size: Float, @ColorInt color: Int, bold: Boolean): TextView {
+        val density = context.resources.displayMetrics.density
+        return text(context, value, size, color, bold).apply {
+            gravity = Gravity.CENTER
+            maxLines = 2
+            ellipsize = android.text.TextUtils.TruncateAt.END
+            setPadding((10 * density).toInt(), 0, (10 * density).toInt(), 0)
+        }
+    }
+
+    private fun outline(radius: Float, @ColorInt color: Int, widthPx: Int, dashed: Boolean, density: Float): GradientDrawable {
+        return GradientDrawable().apply {
+            cornerRadius = radius
+            setColor(Color.TRANSPARENT)
+            if (dashed) setStroke(widthPx, color, 6f * density, 4f * density) else setStroke(widthPx, color)
+        }
+    }
+
+    private fun segment(context: Context, fraction: Float, radiusPx: Int, palette: Palette): View {
+        val track = FrameLayout(context)
+        track.background = GradientDrawable().apply {
+            setColor(palette.track)
+            cornerRadius = radiusPx.toFloat()
+        }
+        track.clipToOutline = true
+        track.addView(View(context).apply {
+            background = GradientDrawable().apply {
+                setColor(palette.onHero)
+                cornerRadius = radiusPx.toFloat()
+            }
+            // Width is set once the segment has been measured.
+            visibility = if (fraction <= 0f) View.GONE else View.VISIBLE
+        }, FrameLayout.LayoutParams(0, FrameLayout.LayoutParams.MATCH_PARENT))
+        track.addOnLayoutChangeListener { v, left, _, right, _, _, _, _, _ ->
+            val fill = (v as FrameLayout).getChildAt(0)
+            val width = ((right - left) * fraction).toInt()
+            if (fill.layoutParams.width != width) {
+                fill.layoutParams.width = width
+                fill.requestLayout()
+            }
+        }
+        return track
+    }
+}
diff --git a/collect_app/src/main/java/org/odk/collect/android/formentry/StageIcon.kt b/collect_app/src/main/java/org/odk/collect/android/formentry/StageIcon.kt
