--- /dev/null
+++ b/collect_app/src/main/java/org/odk/collect/android/formentry/SurveyText.kt
@@ -0,0 +1,43 @@
+package org.odk.collect.android.formentry
+
+/**
+ * Words used by the custom survey screens (stage header, review screen), in English and Malayalam.
+ * Question and section texts come from the form itself and are translated there.
+ */
+class SurveyText(val malayalam: Boolean) {
+    val intro get() = if (malayalam) "ആമുഖം" else "Intro"
+    val household1 get() = if (malayalam) "കുടുംബ വിവരങ്ങൾ 1" else "Household Details 1"
+    val household2 get() = if (malayalam) "കുടുംബ വിവരങ്ങൾ 2" else "Household Details 2"
+    val remarks get() = if (malayalam) "കുറിപ്പുകൾ" else "Remarks"
+    val members get() = if (malayalam) "അംഗങ്ങൾ" else "Members"
+    val previous get() = if (malayalam) "മുമ്പത്തേത്" else "Previous"
+    val next get() = if (malayalam) "അടുത്തത്" else "Next"
+    val review get() = if (malayalam) "സമർപ്പിക്കുന്നതിന് മുമ്പ് പരിശോധിക്കുക" else "Review before you submit"
+    val complete get() = if (malayalam) "പൂർത്തിയായി" else "complete"
+    val go get() = if (malayalam) "പോകുക ›" else "Go ›"
+
+    val removeTitle get() = if (malayalam) "അംഗങ്ങളെ നീക്കം ചെയ്യണോ?" else "Remove members?"
+    val remove get() = if (malayalam) "നീക്കം ചെയ്യുക" else "Remove"
+    val keep get() = if (malayalam) "തിരികെ പോകുക" else "Go back"
+
+    fun removeMessage(newCount: Int, names: List<String>): String {
+        val list = names.joinToString(", ")
+        return if (malayalam) {
+            "കുടുംബാംഗങ്ങളുടെ എണ്ണം $newCount ആക്കി. $list എന്നിവരുടെ വിവരങ്ങൾ ഇല്ലാതാകും."
+        } else {
+            "The household count is now $newCount. The details of $list will be deleted."
+        }
+    }
+
+    fun member(number: Int) = if (malayalam) "അംഗം $number" else "Member $number"
+    fun stage(n: Int, total: Int) = if (malayalam) "ഘട്ടം $n / $total" else "Stage $n of $total"
+
+    companion object {
+        @JvmStatic
+        fun forLanguage(language: String?): SurveyText {
+            val ml = language != null &&
+                (language.contains("Malayalam", ignoreCase = true) || language.endsWith("(ml)") || language == "ml")
+            return SurveyText(ml)
+        }
+    }
+}
