+package org.odk.collect.android.milestones
+
+import android.content.Context
+import android.graphics.drawable.GradientDrawable
+import android.util.TypedValue
+import android.view.Gravity
+import android.view.View
+import android.widget.FrameLayout
+import android.widget.ImageView
+import android.widget.LinearLayout
+import android.widget.TextView
+import androidx.core.content.ContextCompat
+import androidx.core.graphics.ColorUtils
+import com.google.android.material.progressindicator.LinearProgressIndicator
+import org.odk.collect.android.R
+import org.odk.collect.android.milestones.Milestones.Milestone
+import org.odk.collect.android.milestones.Milestones.State
+import org.odk.collect.android.utilities.BoldText
+import org.odk.collect.android.utilities.DesignTint
+import java.text.DateFormat
+import java.util.Date
+
+/** Builds the medals, the Home card and the rows of the Milestones screen from the tally. */
+object MilestoneViews {
+
+    /** A round medal showing the household number, in the milestone's tint when reached. */
+    fun medal(context: Context, milestone: Milestone, state: State, withLabel: Boolean): View {
+        val density = context.resources.displayMetrics.density
+        fun dp(v: Float) = (v * density).toInt()
+        val tint = milestone.tint
+        val fg = tint.fg(context)
+
+        val face = TextView(context).apply {
+            text = milestone.households.toString()
+            gravity = Gravity.CENTER
+            setTextSize(TypedValue.COMPLEX_UNIT_SP, 15f)
+            setTypeface(typeface, android.graphics.Typeface.BOLD)
+            background = GradientDrawable().apply {
+                shape = GradientDrawable.OVAL
+                when (state) {
+                    State.EARNED -> {
+                        setColor(tint.bg(context))
+                        setStroke(dp(1.5f), fg)
+                    }
+                    State.NEXT -> {
+                        setColor(ContextCompat.getColor(context, R.color.dc_card_top))
+                        setStroke(dp(2.5f), fg)
+                    }
+                    State.LOCKED -> {
+                        setColor(ColorUtils.setAlphaComponent(ContextCompat.getColor(context, R.color.dc_card_top), 115))
+                        setStroke(dp(1.5f), ContextCompat.getColor(context, R.color.dc_locked_stroke), dp(4f).toFloat(), dp(3f).toFloat())
+                    }
+                }
+            }
+            setTextColor(if (state == State.LOCKED) ContextCompat.getColor(context, R.color.dc_locked_text) else fg)
+        }
+
+        val faceBox = FrameLayout(context).apply {
+            addView(face, FrameLayout.LayoutParams(dp(46f), dp(46f)))
+            if (state == State.EARNED) {
+                val check = FrameLayout(context).apply {
+                    background = GradientDrawable().apply {
+                        shape = GradientDrawable.OVAL
+                        setColor(fg)
+                        setStroke(dp(1.5f), ContextCompat.getColor(context, R.color.dc_card_top))
+                    }
+                    addView(ImageView(context).apply {
+                        setImageResource(R.drawable.ic_dc_check)
+                        setColorFilter(ContextCompat.getColor(context, R.color.dc_on_hero))
+                        importantForAccessibility = View.IMPORTANT_FOR_ACCESSIBILITY_NO
+                    }, FrameLayout.LayoutParams(dp(10f), dp(10f), Gravity.CENTER))
+                }
+                addView(check, FrameLayout.LayoutParams(dp(16f), dp(16f), Gravity.BOTTOM or Gravity.END))
+            }
+        }
+
+        if (!withLabel) return faceBox
+
+        return LinearLayout(context).apply {
+            orientation = LinearLayout.VERTICAL
+            gravity = Gravity.CENTER_HORIZONTAL
+            addView(faceBox, LinearLayout.LayoutParams(dp(46f), dp(46f)))
+            addView(TextView(context).apply {
+                setText(milestone.name)
+                gravity = Gravity.CENTER
+                maxLines = 2
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 10.5f)
+                setTextColor(
+                    ContextCompat.getColor(context, if (state == State.LOCKED) R.color.dc_locked_text else R.color.dc_ink)
+                )
+            }, LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, LinearLayout.LayoutParams.WRAP_CONTENT).apply {
+                topMargin = dp(5f)
+            })
+        }
+    }
+
+    /** Text such as "3 more households to Ten homes", or the all-done message. */
+    fun nextText(context: Context, households: Int): CharSequence {
+        val next = Milestones.next(households) ?: return context.getString(R.string.milestone_all_reached)
+        val name = context.getString(next.name)
+        val remaining = next.households - households
+        val text = context.resources.getQuantityString(R.plurals.milestone_remaining_to, remaining, remaining, name)
+        return BoldText.of(text, name)
+    }
+
+    fun streakText(context: Context, days: Int): String =
+        context.resources.getQuantityString(R.plurals.milestone_streak, days, days)
+
+    /** Fills the card on the Home screen. [root] is the root of main_menu_milestones.xml. */
+    fun bindCard(root: View, totals: SurveyTally.Totals) {
+        val context = root.context
+        root.findViewById<ImageView>(R.id.milestones_icon).apply {
+            background = DesignTint.SAND.badge(context)
+            setColorFilter(DesignTint.SAND.fg(context))
+        }
+
+        root.findViewById<TextView>(R.id.milestones_next_text).text = nextText(context, totals.households)
+
+        root.findViewById<TextView>(R.id.milestones_streak_chip).apply {
+            if (totals.streakDays >= 2) {
+                visibility = View.VISIBLE
+                text = streakText(context, totals.streakDays)
+                setTextColor(DesignTint.SAND.fg(context))
+                compoundDrawablesRelative[0]?.mutate()?.setTint(DesignTint.SAND.fg(context))
+                background = GradientDrawable().apply {
+                    cornerRadius = 999f
+                    setColor(DesignTint.SAND.bg(context))
+                    setStroke(1, DesignTint.SAND.bd(context))
+                }
+            } else {
+                visibility = View.GONE
+            }
+        }
+
+        root.findViewById<LinearProgressIndicator>(R.id.milestones_progress)
+            .setProgressCompat((Milestones.fractionToNext(totals.households) * 100).toInt(), false)
+
+        val medals = root.findViewById<LinearLayout>(R.id.milestones_medals)
+        medals.removeAllViews()
+        for (milestone in Milestones.all) {
+            val view = medal(context, milestone, Milestones.stateOf(milestone, totals.households), true)
+            medals.addView(view, LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.WRAP_CONTENT, 1f))
+        }
+    }
+
+    /** Fills one row of the Milestones screen. [row] is the root of milestone_row.xml. */
+    fun bindRow(row: View, milestone: Milestone, totals: SurveyTally.Totals) {
+        val context = row.context
+        val state = Milestones.stateOf(milestone, totals.households)
+        val fg = milestone.tint.fg(context)
+
+        row.findViewById<FrameLayout>(R.id.row_medal).apply {
+            removeAllViews()
+            addView(medal(context, milestone, state, false))
+        }
+        row.findViewById<TextView>(R.id.row_title).setText(milestone.name)
+        row.findViewById<TextView>(R.id.row_description).text =
+            if (state == State.NEXT) {
+                context.getString(R.string.milestone_progress, totals.households, milestone.households)
+            } else if (milestone.households == 1) {
+                context.getString(milestone.description)
+            } else {
+                context.getString(milestone.description, milestone.households)
+            }
+
+        row.findViewById<LinearProgressIndicator>(R.id.row_progress).apply {
+            if (state == State.NEXT) {
+                visibility = View.VISIBLE
+                setIndicatorColor(fg)
+                setProgressCompat((totals.households * 100f / milestone.households).toInt(), false)
+            } else {
+                visibility = View.GONE
+            }
+        }
+
+        row.findViewById<TextView>(R.id.row_status).apply {
+            when (state) {
+                State.EARNED -> {
+                    val at = totals.finishTimes.getOrNull(milestone.households - 1)
+                    text = if (at != null) {
+                        context.getString(R.string.milestone_reached_on, DateFormat.getDateInstance(DateFormat.MEDIUM).format(Date(at)))
+                    } else ""
+                    setTextColor(fg)
+                }
+                State.NEXT -> {
+                    text = context.getString(R.string.milestone_to_go, milestone.households - totals.households)
+                    setTextColor(fg)
+                }
+                State.LOCKED -> {
+                    setText(R.string.milestone_locked)
+                    setTextColor(ContextCompat.getColor(context, R.color.dc_locked_text))
+                }
+            }
+        }
+        row.alpha = if (state == State.LOCKED) 0.8f else 1f
+    }
+}
