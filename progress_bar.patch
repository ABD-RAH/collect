+package org.odk.collect.android.formentry
+
+import android.view.Gravity
+import android.view.View
+import android.view.ViewGroup
+import android.widget.TextView
+
+/** Small look-and-feel touches for the community survey screens. */
+object ScreenStyle {
+    /**
+     * Centres the person's name tile (the notes whose names start with "who_") at the top of
+     * each member screen. Any other screen or form is left alone.
+     */
+    @JvmStatic
+    fun centerMemberName(odkView: ODKView) {
+        try {
+            for (widget in odkView.widgets) {
+                val name = widget.formEntryPrompt.index.reference.nameLast ?: continue
+                if (name.startsWith("who_")) {
+                    centerAllText(widget)
+                }
+            }
+        } catch (e: RuntimeException) {
+            // purely cosmetic: ignore
+        }
+    }
+
+    private fun centerAllText(view: View) {
+        if (view is TextView) {
+            view.gravity = Gravity.CENTER_HORIZONTAL
+            view.textAlignment = View.TEXT_ALIGNMENT_CENTER
+            val params = view.layoutParams
+            if (params != null && params.width != ViewGroup.LayoutParams.MATCH_PARENT) {
+                params.width = ViewGroup.LayoutParams.MATCH_PARENT
+                view.layoutParams = params
+            }
+        } else if (view is ViewGroup) {
+            for (i in 0 until view.childCount) {
+                centerAllText(view.getChildAt(i))
+            }
+        }
+    }
+}
