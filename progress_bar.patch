+++ b/collect_app/src/main/java/org/odk/collect/android/milestones/SurveyTally.kt
@@ -0,0 +1,70 @@
+package org.odk.collect.android.milestones
+
+import android.content.Context
+import java.time.Instant
+import java.time.LocalDate
+import java.time.ZoneId
+
+/**
+ * A running count, kept on this phone only, of the households this surveyor has finished and the
+ * family members in them. It stores just numbers and dates: no answers, names or keys. Each
+ * finished form is recorded once, under its own file path, so finalising the same form again never
+ * counts it twice. Clearing the app's data or uninstalling it resets the tally.
+ */
+object SurveyTally {
+    private const val FILE = "survey_tally"
+    private const val ENTRY_PREFIX = "inst:"
+
+    data class Entry(val id: String, val members: Int, val finishedAt: Long)
+
+    /** Records a finished household. Safe to call more than once for the same form. */
+    @JvmStatic
+    fun record(context: Context, instanceId: String, members: Int, now: Long = System.currentTimeMillis()) {
+        val prefs = context.applicationContext.getSharedPreferences(FILE, Context.MODE_PRIVATE)
+        val key = ENTRY_PREFIX + instanceId
+        // Keep the original date if this form was already counted; only the member count may change.
+        val first = parse(prefs.getString(key, null))?.finishedAt ?: now
+        prefs.edit().putString(key, "${members.coerceAtLeast(0)},$first").apply()
+    }
+
+    fun entries(context: Context): List<Entry> {
+        val prefs = context.applicationContext.getSharedPreferences(FILE, Context.MODE_PRIVATE)
+        return prefs.all.mapNotNull { (key, value) ->
+            if (!key.startsWith(ENTRY_PREFIX)) return@mapNotNull null
+            parse(value as? String)?.copy(id = key.removePrefix(ENTRY_PREFIX))
+        }.sortedBy { it.finishedAt }
+    }
+
+    private fun parse(value: String?): Entry? {
+        val parts = value?.split(",") ?: return null
+        val members = parts.getOrNull(0)?.toIntOrNull() ?: return null
+        val at = parts.getOrNull(1)?.toLongOrNull() ?: return null
+        return Entry("", members, at)
+    }
+
+    data class Totals(
+        val households: Int,
+        val people: Int,
+        val streakDays: Int,
+        /** Finish times of the households, oldest first (used for "reached on" dates). */
+        val finishTimes: List<Long>
+    )
+
+    fun totals(context: Context, today: LocalDate = LocalDate.now()): Totals {
+        val all = entries(context)
+        val zone = ZoneId.systemDefault()
+        val days = all.map { Instant.ofEpochMilli(it.finishedAt).atZone(zone).toLocalDate() }.toSet()
+        return Totals(all.size, all.sumOf { it.members }, streak(days, today), all.map { it.finishedAt })
+    }
+
+    /** Consecutive days with at least one finished household, ending today (or yesterday). */
+    internal fun streak(days: Set<LocalDate>, today: LocalDate): Int {
+        var day = if (today in days) today else today.minusDays(1)
+        var count = 0
+        while (day in days) {
+            count++
+            day = day.minusDays(1)
+        }
+        return count
+    }
+}
