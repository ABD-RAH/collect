+
+/** Lists every milestone with how far this surveyor is. Numbers come from this phone's tally. */
+class MilestonesActivity : LocalizedActivity() {
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        setContentView(R.layout.activity_milestones)
+        window.setBackgroundDrawable(
+            org.odk.collect.android.utilities.DesignChrome.appBackground(this)
+        )
+        WindowCompat.getInsetsController(window, window.decorView).isAppearanceLightStatusBars = false
+
+        val hero = findViewById<android.view.View>(R.id.milestones_hero)
+        hero.background = org.odk.collect.android.utilities.DesignChrome.heroBackground(this, 180f)
+        val baseTop = hero.paddingTop
+        val list = findViewById<LinearLayout>(R.id.milestones_list)
+        val baseBottom = list.paddingBottom
+        ViewCompat.setOnApplyWindowInsetsListener(findViewById(R.id.milestones_root)) { _, insets ->
+            val bars = insets.getInsets(WindowInsetsCompat.Type.systemBars())
+            org.odk.collect.android.utilities.DesignChrome.setHeroTopInset(hero.background, bars.top)
+            hero.setPadding(hero.paddingLeft, baseTop + bars.top, hero.paddingRight, hero.paddingBottom)
+            list.setPadding(list.paddingLeft, list.paddingTop, list.paddingRight, baseBottom + bars.bottom)
+            insets
+        }
+
+        findViewById<android.view.View>(R.id.milestones_back).setOnClickListener { finish() }
+    }
+
+    override fun onResume() {
+        super.onResume()
+        val totals = SurveyTally.totals(this)
+
+        val next = Milestones.next(totals.households)
+        findViewById<CircularProgressIndicator>(R.id.milestones_ring)
+            .setProgressCompat((Milestones.fractionToNext(totals.households) * 100).toInt(), false)
+        findViewById<TextView>(R.id.milestones_ring_count).text = totals.households.toString()
+        findViewById<TextView>(R.id.milestones_ring_of).text =
+            if (next != null) getString(R.string.milestone_ring_of, next.households) else ""
+        findViewById<TextView>(R.id.milestones_hero_title).text =
+            if (next != null) getString(next.name) else getString(R.string.milestone_all_reached)
+        val remaining = if (next != null) {
+            resources.getQuantityString(R.plurals.milestone_remaining_short, next.households - totals.households, next.households - totals.households)
+        } else ""
+        val streak = if (totals.streakDays >= 2) MilestoneViews.streakText(this, totals.streakDays) else ""
+        findViewById<TextView>(R.id.milestones_hero_text).text =
+            listOf(remaining, streak).filter { it.isNotEmpty() }.joinToString("\n")
+
+        val list = findViewById<LinearLayout>(R.id.milestones_list)
+        list.removeAllViews()
+        val inflater = LayoutInflater.from(this)
+        for (milestone in Milestones.all) {
+            val row = inflater.inflate(R.layout.milestone_row, list, false)
+            MilestoneViews.bindRow(row, milestone, totals)
+            list.addView(row)
+        }
+    }
+}
diff --git a/collect_app/src/main/java/org/odk/collect/android/milestones/SurveyTally.kt b/collect_app/src/main/java/org/odk/collect/android/milestones/SurveyTally.kt
