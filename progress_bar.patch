diff --git a/collect_app/src/main/java/org/odk/collect/android/formentry/FormProgress.kt b/collect_app/src/main/java/org/odk/collect/android/formentry/FormProgress.kt
new file mode 100644
index 0000000..bbc6db4
--- /dev/null
+++ b/collect_app/src/main/java/org/odk/collect/android/formentry/FormProgress.kt
@@ -0,0 +1,57 @@
+package org.odk.collect.android.formentry
+
+import org.javarosa.core.model.FormIndex
+import org.javarosa.form.api.FormEntryController
+import org.odk.collect.android.exception.JavaRosaException
+import org.odk.collect.android.javarosawrapper.FormController
+
+/**
+ * Works out how far through the form the user is, counted in screens.
+ *
+ * It walks the form from the start the same way the Next button does, so skipped
+ * (non-relevant) questions are not counted and repeat instances are counted once each.
+ * The total is recomputed every time, so it follows the answers given so far.
+ * The current position is always put back before returning.
+ */
+data class FormProgress(val current: Int, val total: Int) {
+    val percent: Int
+        get() = if (total <= 0) 0 else (current * 100 / total).coerceIn(0, 100)
+
+    companion object {
+        @JvmStatic
+        fun calculate(formController: FormController): FormProgress? {
+            val original: FormIndex = formController.getFormIndex()
+            return try {
+                val originalEvent = formController.getEvent()
+                formController.jumpToIndex(FormIndex.createBeginningOfFormIndex())
+
+                var total = 0
+                var current = 0
+                var event = formController.stepToNextScreenEvent()
+                while (event != FormEntryController.EVENT_END_OF_FORM) {
+                    if (event == FormEntryController.EVENT_QUESTION ||
+                        event == FormEntryController.EVENT_GROUP ||
+                        event == FormEntryController.EVENT_REPEAT
+                    ) {
+                        total++
+                        if (formController.getFormIndex() == original) {
+                            current = total
+                        }
+                    }
+                    event = formController.stepToNextScreenEvent()
+                }
+
+                if (originalEvent == FormEntryController.EVENT_END_OF_FORM) {
+                    current = total
+                }
+                FormProgress(current, total)
+            } catch (e: JavaRosaException) {
+                null
+            } catch (e: RuntimeException) {
+                null
+            } finally {
+                formController.jumpToIndex(original)
+            }
+        }
+    }
+}
