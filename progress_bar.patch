+++ b/collect_app/src/main/java/org/odk/collect/android/milestones/HouseholdCompleteActivity.kt
@@ -0,0 +1,157 @@
+package org.odk.collect.android.milestones
+
+import android.animation.ValueAnimator
+import android.os.Bundle
+import android.view.View
+import android.view.animation.DecelerateInterpolator
+import android.view.animation.OvershootInterpolator
+import android.widget.TextView
+import androidx.activity.OnBackPressedCallback
+import androidx.core.view.ViewCompat
+import androidx.core.view.WindowCompat
+import androidx.core.view.WindowInsetsCompat
+import com.google.android.material.progressindicator.CircularProgressIndicator
+import org.odk.collect.android.R
+import org.odk.collect.android.formmanagement.FormFillingIntentFactory
+import org.odk.collect.android.utilities.DesignChrome
+import org.odk.collect.strings.localization.LocalizedActivity
+
+/**
+ * Shown for a moment after a household is finished: a check mark pops in, the progress ring
+ * fills to this surveyor's position, and the counts on this phone tick up. Numbers come only from
+ * the on-phone tally. Nothing here rewards speed, and the screen never blocks: Done (or Back)
+ * returns to wherever the form was opened from.
+ */
+class HouseholdCompleteActivity : LocalizedActivity() {
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        setContentView(R.layout.activity_household_complete)
+        WindowCompat.getInsetsController(window, window.decorView).isAppearanceLightStatusBars = false
+        window.setBackgroundDrawable(DesignChrome.appBackground(this))
+
+        val hero = findViewById<View>(R.id.complete_hero)
+        hero.background = DesignChrome.heroBackground(this, 260f)
+        // Centre the ring of people on the check mark once everything has been laid out.
+        val checkFrame = findViewById<View>(R.id.complete_check_frame)
+        hero.addOnLayoutChangeListener { _, _, _, _, _, _, _, _, _ ->
+            val h = IntArray(2)
+            val c = IntArray(2)
+            hero.getLocationInWindow(h)
+            checkFrame.getLocationInWindow(c)
+            DesignChrome.setHeroCenter(hero.background, c[1] - h[1] + checkFrame.height / 2)
+        }
+        val bottom = findViewById<View>(R.id.complete_bottom)
+        val baseBottom = bottom.paddingBottom
+        val baseTop = hero.paddingTop
+        ViewCompat.setOnApplyWindowInsetsListener(findViewById(R.id.complete_root)) { _, insets ->
+            val bars = insets.getInsets(WindowInsetsCompat.Type.systemBars())
+            hero.setPadding(hero.paddingLeft, baseTop + bars.top, hero.paddingRight, hero.paddingBottom)
+            bottom.setPadding(bottom.paddingLeft, bottom.paddingTop, bottom.paddingRight, baseBottom + bars.bottom)
+            insets
+        }
+
+        val done = findViewById<View>(R.id.complete_done)
+        done.setOnClickListener { finish() }
+        val next = findViewById<View>(R.id.complete_next)
+        val nextFormUri = intent.getStringExtra(EXTRA_NEXT_FORM_URI)?.let { android.net.Uri.parse(it) }
+        if (nextFormUri == null) {
+            next.visibility = View.GONE
+        } else {
+            next.setOnClickListener {
+                // Opens a fresh copy of the same form; when it is finished the surveyor lands on Home.
+                startActivity(FormFillingIntentFactory.newFormIntent(this, nextFormUri))
+                finish()
+            }
+        }
+        onBackPressedDispatcher.addCallback(this, object : OnBackPressedCallback(true) {
+            override fun handleOnBackPressed() = finish()
+        })
+
+        val totals = SurveyTally.totals(this)
+        val latest = SurveyTally.entries(this).lastOrNull()
+        if (latest == null) {
+            // Nothing was recorded (should not happen); never leave the surveyor on a blank page.
+            finish()
+            return
+        }
+
+        val members = latest.members
+        val subtitle = findViewById<TextView>(R.id.complete_subtitle)
+        subtitle.text = if (members > 0) {
+            resources.getQuantityString(R.plurals.complete_people_added, members, members)
+        } else {
+            getString(R.string.complete_household_saved)
+        }
+
+        val households = findViewById<TextView>(R.id.complete_households)
+        val people = findViewById<TextView>(R.id.complete_people)
+        val ring = findViewById<CircularProgressIndicator>(R.id.complete_ring)
+        val check = findViewById<View>(R.id.complete_check)
+        val stats = findViewById<View>(R.id.complete_stats)
+        val note = findViewById<TextView>(R.id.complete_note)
+
+        val reached = Milestones.all.firstOrNull { it.households == totals.households }
+        val nextMilestone = Milestones.next(totals.households)
+        val parts = mutableListOf<String>()
+        if (reached != null) parts.add(getString(R.string.complete_milestone_reached, getString(reached.name)))
+        else if (nextMilestone != null) parts.add(
+            resources.getQuantityString(
+                R.plurals.milestone_remaining_to, nextMilestone.households - totals.households,
+                nextMilestone.households - totals.households, getString(nextMilestone.name)
+            )
+        )
+        if (totals.streakDays >= 2) parts.add(MilestoneViews.streakText(this, totals.streakDays))
+        if (parts.isNotEmpty()) {
+            note.text = parts.joinToString("\n")
+            note.visibility = View.VISIBLE
+        }
+
+        val startPeople = (totals.people - members).coerceAtLeast(0)
+
+        // Final values are set first so the page is correct even if animations are turned off.
+        households.text = totals.households.toString()
+        people.text = totals.people.toString()
+
+        // The check pops in.
+        check.scaleX = 0f
+        check.scaleY = 0f
+        check.alpha = 0f
+        check.animate().scaleX(1f).scaleY(1f).alpha(1f).setStartDelay(150).setDuration(520)
+            .setInterpolator(OvershootInterpolator(1.8f)).start()
+
+        // Every finished household fills the ring completely.
+        ring.setProgressCompat(0, false)
+        ring.postDelayed({ if (!isDestroyed) ring.setProgressCompat(100, true) }, 500)
+
+        // Counts tick up from the previous total.
+        count(households, (totals.households - 1).coerceAtLeast(0), totals.households)
+        count(people, startPeople, totals.people)
+
+        // Cards rise in one after another.
+        var delay = 450L
+        for (v in listOf(stats, note, next, done)) {
+            if (v.visibility != View.VISIBLE) continue
+            v.alpha = 0f
+            v.translationY = 40f
+            v.animate().alpha(1f).translationY(0f).setStartDelay(delay).setDuration(420)
+                .setInterpolator(DecelerateInterpolator()).start()
+            delay += 140
+        }
+    }
+
+    private fun count(view: TextView, from: Int, to: Int) {
+        view.text = from.toString()
+        ValueAnimator.ofInt(from, to).apply {
+            startDelay = 700
+            duration = 700
+            addUpdateListener { view.text = (it.animatedValue as Int).toString() }
+            start()
+        }
+    }
+
+    companion object {
+        /** Content URI of the form to open again for "Record next household". Optional. */
+        const val EXTRA_NEXT_FORM_URI = "next_form_uri"
+    }
+}
