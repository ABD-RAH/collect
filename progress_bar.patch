@@ -0,0 +1,42 @@
+package org.odk.collect.android.formentry
+
+import androidx.annotation.DrawableRes
+import org.javarosa.core.model.FormIndex
+import org.odk.collect.android.R
+
+/**
+ * Picks the line icon for the section the user is currently in, from the names of the groups the
+ * current screen sits in (the same names as in the XLSForm). The innermost known group wins.
+ * Unknown groups keep the previous icon, and a screen with no known group falls back to a person.
+ */
+object StageIcon {
+    private val BY_GROUP = mapOf(
+        "consent_grp" to R.drawable.ic_dc_intro,
+        "respondent_grp" to R.drawable.ic_dc_house,
+        "basic_details" to R.drawable.ic_dc_house,
+        "sec1_top" to R.drawable.ic_dc_house,
+        "roster_grp" to R.drawable.ic_dc_person,
+        "roster_summary_grp" to R.drawable.ic_dc_members,
+        "member_details" to R.drawable.ic_dc_person,
+        "ncd_grp" to R.drawable.ic_dc_heart,
+        "disability_grp" to R.drawable.ic_dc_wheel,
+        "mh_top" to R.drawable.ic_dc_mind,
+        "mental_health_grp" to R.drawable.ic_dc_mind,
+        "elderly_grp" to R.drawable.ic_dc_elder,
+        "palliative_grp" to R.drawable.ic_dc_care,
+        "sec1b" to R.drawable.ic_dc_house2,
+        "sec6" to R.drawable.ic_dc_note
+    )
+
+    @JvmStatic
+    @DrawableRes
+    fun forIndex(index: FormIndex?, atEnd: Boolean): Int {
+        if (atEnd) return R.drawable.ic_dc_done
+        val reference = index?.reference ?: return R.drawable.ic_dc_person
+        var result = R.drawable.ic_dc_person
+        for (i in 0 until reference.size()) {
+            BY_GROUP[reference.getName(i)]?.let { result = it }
+        }
+        return result
+    }
+}
diff --git a/collect_app/src/main/java/org/odk/collect/android/formentry/StageProgress.kt b/collect_app/src/main/java/org/odk/collect/android/formentry/StageProgress.kt
new file mode 100644
index 0000000..a50f3da
--- /dev/null
+++ b/collect_app/src/main/java/org/odk/collect/android/formentry/StageProgress.kt
@@ -0,0 +1,237 @@
+package org.odk.collect.android.formentry
+
+import org.javarosa.core.model.FormIndex
+import org.javarosa.form.api.FormEntryController
+import org.odk.collect.android.exception.JavaRosaException
+import org.odk.collect.android.javarosawrapper.FormController
+
+/**
+ * Works out which "stage" of the community survey the user is in, and how far through that stage.
+ *
+ * Stages, in order: Intro, Household details 1, one stage per family member (labelled with the
+ * name entered so far), Household details 2, Remarks.
+ *
+ * Which stage a screen belongs to is decided from the names of the groups it sits in (the same
+ * names as in the XLSForm). The form is walked from the start the same way the Next button does,
+ * so screens that are skipped (not relevant) are not counted. The current position is always put
+ * back before returning.
+ */
+object StageProgress {
+    data class Stage(
+        val label: String,
+        /** First screen of this stage, or null if the user has not reached it yet. */
+        val first: FormIndex?,
+        val total: Int,
+        /** Screens of this stage up to and including the current one (only for the current stage). */
+        val position: Int
+    ) {
+        val fraction: Float
+            get() = if (total <= 0) 0f else (position.toFloat() / total).coerceIn(0f, 1f)
+    }
+
+    data class State(
+        val stages: List<Stage>,
+        val current: Int,
+        val atEnd: Boolean = false,
+        val text: SurveyText = SurveyText(false)
+    )
+
+    data class Item(val text: String, val index: FormIndex, val answered: Boolean)
+
+    /** One line of the end-of-form review: a stage or a person with how many questions are answered. */
+    data class ReviewRow(
+        val label: String,
+        val answered: Int,
+        val total: Int,
+        val items: List<Item>,
+        @androidx.annotation.DrawableRes val iconRes: Int = org.odk.collect.android.R.drawable.ic_dc_person
+    )
+
+    private const val INTRO = "intro"
+    private const val HH1 = "hh1"
+    private const val HH2 = "hh2"
+    private const val REMARKS = "remarks"
+    private const val MEMBER_PREFIX = "m"
+
+    private class Acc {
+        var first: FormIndex? = null
+        var total = 0
+        var position = 0
+    }
+
+    private fun keyFor(formController: FormController, previous: String): String {
+        val reference = formController.getFormIndex().reference ?: return previous
+        var drilldown = -1
+        var key = previous
+        for (i in 0 until reference.size()) {
+            when (reference.getName(i)) {
+                "member_drilldown" -> drilldown = maxOf(reference.getMultiplicity(i), 0)
+                "consent_grp" -> key = INTRO
+                "respondent_grp", "basic_details", "sec1_top", "family_members", "roster_summary_grp" -> key = HH1
+                "sec1b" -> key = HH2
+                "sec6" -> key = REMARKS
+            }
+        }
+        return if (drilldown >= 0) MEMBER_PREFIX + drilldown else key
+    }
+
+
+    /** Stage keys in display order, and their labels. */
+    private fun orderedKeys(seen: Set<String>, names: List<String>, text: SurveyText): Pair<List<String>, Map<String, String>> {
+        val memberCount = seen.count { it.startsWith(MEMBER_PREFIX) }
+        val keys = mutableListOf(INTRO, HH1)
+        val labels = mutableMapOf(
+            INTRO to text.intro, HH1 to text.household1,
+            HH2 to text.household2, REMARKS to text.remarks
+        )
+        if (memberCount == 0) {
+            keys.add("m0")
+            labels["m0"] = text.members
+        } else {
+            for (k in 0 until memberCount) {
+                keys.add(MEMBER_PREFIX + k)
+                labels[MEMBER_PREFIX + k] = names.getOrNull(k)?.takeIf { it.isNotBlank() } ?: text.member(k + 1)
+            }
+        }
+        keys.add(HH2)
+        keys.add(REMARKS)
+        return Pair(keys, labels)
+    }
+
+    private fun iconFor(key: String): Int = when (key) {
+        INTRO -> org.odk.collect.android.R.drawable.ic_dc_intro
+        HH1 -> org.odk.collect.android.R.drawable.ic_dc_house
+        HH2 -> org.odk.collect.android.R.drawable.ic_dc_house2
+        REMARKS -> org.odk.collect.android.R.drawable.ic_dc_note
+        else -> org.odk.collect.android.R.drawable.ic_dc_person
+    }
+
+    private val SECTION_PREFIX = Regex("^\\s*(Section|ഭാഗം)\\s+\\d+\\s*(of|/)\\s*\\d+\\s*:\\s*")
+
+    /** The current section's name for the stage pill, or null when it just repeats the stage label. */
+    @JvmStatic
+    fun sectionName(state: State, sectionCaption: String?): String? {
+        if (state.atEnd) return null
+        val stage = state.stages.getOrNull(state.current)?.label ?: ""
+        val section = sectionCaption?.replace(SECTION_PREFIX, "")?.trim().orEmpty()
+        return section.takeIf { it.isNotEmpty() && !it.equals(stage, ignoreCase = true) }
+    }
+
+    /** Text for the left side of the header: "<person> · <section>" (or just the section). */
+    @JvmStatic
+    fun headerTitle(state: State, sectionCaption: String?): String {
+        if (state.atEnd) return state.text.review
+        val stage = state.stages.getOrNull(state.current)?.label ?: ""
+        val section = sectionCaption?.replace(SECTION_PREFIX, "")?.trim().orEmpty()
+        val isMember = state.current >= 2 && state.current < state.stages.size - 2
+        return when {
+            section.isEmpty() -> stage
+            isMember && !section.equals(stage, ignoreCase = true) -> "$stage · $section"
+            else -> section
+        }
+    }
+
+    /**
+     * For the end-of-form screen: every stage / person with how many of their relevant questions
+     * are answered, and which ones are not. Only questions that are currently relevant are
+     * counted; read-only notes are ignored.
+     */
+    @JvmStatic
+    fun review(formController: FormController): List<ReviewRow>? {
+        val original: FormIndex = formController.getFormIndex()
+        return try {
+            formController.jumpToIndex(FormIndex.createBeginningOfFormIndex())
+            val answered = LinkedHashMap<String, Int>()
+            val total = LinkedHashMap<String, Int>()
+            val items = LinkedHashMap<String, MutableList<Item>>()
+            var lastKey = INTRO
+            var event = formController.stepToNextEvent(true)
+            while (event != FormEntryController.EVENT_END_OF_FORM) {
+                if (event == FormEntryController.EVENT_QUESTION) {
+                    val prompt = formController.getQuestionPrompt()
+                    if (prompt != null && !prompt.isReadOnly) {
+                        val key = keyFor(formController, lastKey)
+                        lastKey = key
+                        total[key] = (total[key] ?: 0) + 1
+                        val value = prompt.answerValue?.displayText
+                        val isAnswered = prompt.answerValue != null && !value.isNullOrBlank()
+                        if (isAnswered) {
+                            answered[key] = (answered[key] ?: 0) + 1
+                        }
+                        val text = (prompt.questionText ?: prompt.longText ?: "").replace(Regex("<[^>]*>"), "").trim()
+                        items.getOrPut(key) { mutableListOf() }.add(Item(text, formController.getFormIndex(), isAnswered))
+                    }
+                }
+                event = formController.stepToNextEvent(true)
+            }
+
+            val (keys, labels) = orderedKeys(total.keys, RosterTable.memberNames(formController), SurveyText.forLanguage(formController.getLanguage()))
+            keys.map { key ->
+                ReviewRow(labels.getValue(key), answered[key] ?: 0, total[key] ?: 0, items[key] ?: emptyList(), iconFor(key))
+            }
+        } catch (e: JavaRosaException) {
+            null
+        } catch (e: RuntimeException) {
+            null
+        } finally {
+            formController.jumpToIndex(original)
+        }
+    }
+
+    @JvmStatic
+    fun calculate(formController: FormController): State? {
+        val original: FormIndex = formController.getFormIndex()
+        return try {
+            val originalEvent = formController.getEvent()
+            val text = SurveyText.forLanguage(formController.getLanguage())
+            formController.jumpToIndex(FormIndex.createBeginningOfFormIndex())
+
+            val accs = LinkedHashMap<String, Acc>()
+            var lastKey = INTRO
+            var currentKey: String? = null
+            var event = formController.stepToNextScreenEvent()
+            while (event != FormEntryController.EVENT_END_OF_FORM) {
+                if (event == FormEntryController.EVENT_QUESTION ||
+                    event == FormEntryController.EVENT_GROUP ||
+                    event == FormEntryController.EVENT_REPEAT
+                ) {
+                    val key = keyFor(formController, lastKey)
+                    lastKey = key
+                    val acc = accs.getOrPut(key) { Acc() }
+                    if (acc.first == null) acc.first = formController.getFormIndex()
+                    acc.total++
+                    if (currentKey == null && formController.getFormIndex() == original) {
+                        currentKey = key
+                        acc.position = acc.total
+                    }
+                }
+                event = formController.stepToNextScreenEvent()
+            }
+
+            if (originalEvent == FormEntryController.EVENT_END_OF_FORM) {
+                currentKey = lastKey
+                accs[lastKey]?.let { it.position = it.total }
+            }
+
+            val (keys, labels) = orderedKeys(accs.keys, RosterTable.memberNames(formController), text)
+
+            val stages = keys.map { key ->
+                val acc = accs[key]
+                // Stages before the current one are complete; later ones are empty.
+                Stage(labels.getValue(key), acc?.first, acc?.total ?: 0, acc?.position ?: 0)
+            }
+            val current = keys.indexOf(currentKey ?: INTRO).coerceAtLeast(0)
+            // Earlier stages count as fully done.
+            val adjusted = stages.mapIndexed { i, s ->
+                if (i < current) s.copy(position = s.total) else s
+            }
+            State(adjusted, current, originalEvent == FormEntryController.EVENT_END_OF_FORM, text)
+        } catch (e: JavaRosaException) {
+            null
+        } catch (e: RuntimeException) {
+            null
+        } finally {
+            formController.jumpToIndex(original)
+        }
+    }
+}
diff --git a/collect_app/src/main/java/org/odk/collect/android/formentry/SurveyText.kt b/collect_app/src/main/java/org/odk/collect/android/formentry/SurveyText.kt
new file mode 100644
