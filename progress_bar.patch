@@ -0,0 +1,86 @@
+package org.odk.collect.android.utilities
+
+import android.app.Activity
+import android.content.Context
+import android.graphics.drawable.ColorDrawable
+import android.graphics.drawable.LayerDrawable
+import android.view.View
+import androidx.appcompat.widget.Toolbar
+import androidx.core.content.ContextCompat
+import androidx.core.view.WindowCompat
+import com.google.android.material.appbar.AppBarLayout
+import org.odk.collect.android.R
+
+/**
+ * Makes the native top bar and the system status bar the same colour as the top of the header
+ * gradient, so the toolbar and the header below it read as one block. All colours come from
+ * design_tokens.xml.
+ */
+object DesignChrome {
+    @JvmStatic
+    fun applyHeroChrome(activity: Activity, appBar: View?, toolbar: Toolbar?) {
+        val start = ContextCompat.getColor(activity, R.color.dc_hero_start)
+        val onHero = ContextCompat.getColor(activity, R.color.dc_on_hero)
+
+        // Shows behind the status bar (top) and the navigation area (bottom) when the app draws
+        // edge to edge: header colour at the top, the page background colour everywhere else.
+        activity.window.setBackgroundDrawable(windowBackground(activity))
+        @Suppress("DEPRECATION")
+        activity.window.statusBarColor = start
+        WindowCompat.getInsetsController(activity.window, activity.window.decorView).apply {
+            isAppearanceLightStatusBars = false
+            isAppearanceLightNavigationBars = true
+        }
+
+        appBar?.setBackgroundColor(start)
+        (appBar as? AppBarLayout)?.apply {
+            elevation = 0f
+            stateListAnimator = null
+        }
+
+        toolbar?.let { bar ->
+            bar.setBackgroundColor(start)
+            bar.setTitleTextColor(onHero)
+            bar.navigationIcon?.setTint(onHero)
+            // The overflow icon only exists once the toolbar has been laid out.
+            bar.post { bar.overflowIcon?.setTint(onHero) }
+        }
+    }
+
+    /** The soft green gradient with the faint constellation of people on top. */
+    @JvmStatic
+    fun appBackground(context: Context): LayerDrawable {
+        val gradient = ContextCompat.getDrawable(context, R.drawable.dc_bg)!!.mutate()
+        return LayerDrawable(arrayOf(gradient, ConstellationDrawable(context, 0.2f)))
+    }
+
+    /** The header gradient with a very faint ring of people centred behind the content. */
+    @JvmStatic
+    fun heroBackground(context: Context, ringSizeDp: Float = 170f): LayerDrawable {
+        val hero = ContextCompat.getDrawable(context, R.drawable.dc_hero)!!.mutate()
+        return LayerDrawable(arrayOf(hero, RingDrawable(context, ringSizeDp, 0.2f)))
+    }
+
+    /** Tells the ring in a [heroBackground] how much of the top is status bar, so it stays centred in the visible header. */
+    @JvmStatic
+    fun setHeroTopInset(background: android.graphics.drawable.Drawable?, insetPx: Int) {
+        ((background as? LayerDrawable)?.getDrawable(1) as? RingDrawable)?.topInsetPx = insetPx
+    }
+
+    /** Centres the ring of a [heroBackground] at [centerYPx] (in the header's own coordinates). */
+    @JvmStatic
+    fun setHeroCenter(background: android.graphics.drawable.Drawable?, centerYPx: Int) {
+        ((background as? LayerDrawable)?.getDrawable(1) as? RingDrawable)?.centerYPx = centerYPx
+    }
+
+    private fun windowBackground(context: Context): LayerDrawable {
+        val density = context.resources.displayMetrics.density
+        val page = ColorDrawable(ContextCompat.getColor(context, R.color.dc_bg_bottom))
+        val top = ColorDrawable(ContextCompat.getColor(context, R.color.dc_hero_start))
+        return LayerDrawable(arrayOf(page, top)).apply {
+            // Tall enough to cover any status bar; everything below it is covered by the screen itself.
+            setLayerHeight(1, (200 * density).toInt())
+            setLayerGravity(1, android.view.Gravity.TOP)
+        }
+    }
+}
