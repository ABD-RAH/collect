+package org.odk.collect.android.milestones
+
+import androidx.annotation.StringRes
+import org.odk.collect.android.R
+import org.odk.collect.android.utilities.DesignTint
+
+/**
+ * The household milestones, in order. To add or change one, edit this list (and its strings).
+ * Nothing about speed is rewarded; the milestones only count finished households.
+ */
+object Milestones {
+    data class Milestone(
+        val households: Int,
+        @StringRes val name: Int,
+        @StringRes val description: Int,
+        val tint: DesignTint
+    )
+
+    val all = listOf(
+        Milestone(1, R.string.milestone_first_visit, R.string.milestone_first_visit_description, DesignTint.SKY),
+        Milestone(5, R.string.milestone_five_homes, R.string.milestone_households_surveyed, DesignTint.GREEN),
+        Milestone(10, R.string.milestone_ten_homes, R.string.milestone_households_surveyed, DesignTint.SAND),
+        Milestone(25, R.string.milestone_25_homes, R.string.milestone_households_surveyed, DesignTint.LILAC),
+        Milestone(50, R.string.milestone_50_homes, R.string.milestone_households_surveyed, DesignTint.CORAL)
+    )
+
+    enum class State { EARNED, NEXT, LOCKED }
+
+    fun stateOf(milestone: Milestone, households: Int): State {
+        if (households >= milestone.households) return State.EARNED
+        val next = next(households)
+        return if (next == milestone) State.NEXT else State.LOCKED
+    }
+
+    /** The first milestone not yet reached, or null when all are. */
+    fun next(households: Int): Milestone? = all.firstOrNull { households < it.households }
+
+    /** Progress towards [next] from the previous milestone, 0..1. */
+    fun fractionToNext(households: Int): Float {
+        val next = next(households) ?: return 1f
+        return (households.toFloat() / next.households).coerceIn(0f, 1f)
+    }
+}
