diff --git a/collect_app/src/main/res/layout/activity_household_complete.xml b/collect_app/src/main/res/layout/activity_household_complete.xml
new file mode 100644
index 0000000..86fb6e7
--- /dev/null
+++ b/collect_app/src/main/res/layout/activity_household_complete.xml
@@ -0,0 +1,197 @@
+<?xml version="1.0" encoding="utf-8"?>
+<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    xmlns:app="http://schemas.android.com/apk/res-auto"
+    xmlns:tools="http://schemas.android.com/tools"
+    android:id="@+id/complete_root"
+    android:layout_width="match_parent"
+    android:layout_height="match_parent"
+    android:orientation="vertical">
+
+    <!-- Top half: the check mark drawing itself inside a progress ring. -->
+    <FrameLayout
+        android:id="@+id/complete_hero"
+        android:layout_width="match_parent"
+        android:layout_height="0dp"
+        android:layout_weight="1"
+        android:background="@drawable/dc_hero">
+
+        <LinearLayout
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:layout_gravity="center"
+            android:gravity="center_horizontal"
+            android:orientation="vertical"
+            android:paddingHorizontal="24dp">
+
+            <FrameLayout
+                android:id="@+id/complete_check_frame"
+                android:layout_width="132dp"
+                android:layout_height="132dp">
+
+                <View
+                    android:layout_width="124dp"
+                    android:layout_height="124dp"
+                    android:layout_gravity="center"
+                    android:background="@drawable/dc_complete_disc" />
+
+                <com.google.android.material.progressindicator.CircularProgressIndicator
+                    android:id="@+id/complete_ring"
+                    android:layout_width="wrap_content"
+                    android:layout_height="wrap_content"
+                    android:layout_gravity="center"
+                    android:max="100"
+                    app:indicatorColor="@color/dc_gold_ring"
+                    app:indicatorInset="0dp"
+                    app:indicatorSize="124dp"
+                    app:trackColor="@color/dc_hero_track"
+                    app:trackCornerRadius="4dp"
+                    app:trackThickness="7dp" />
+
+                <ImageView
+                    android:id="@+id/complete_check"
+                    android:layout_width="64dp"
+                    android:layout_height="64dp"
+                    android:layout_gravity="center"
+                    android:importantForAccessibility="no"
+                    android:src="@drawable/ic_dc_check"
+                    app:tint="@color/dc_on_hero" />
+            </FrameLayout>
+
+            <TextView
+                android:id="@+id/complete_title"
+                android:layout_width="wrap_content"
+                android:layout_height="wrap_content"
+                android:layout_marginTop="48dp"
+                android:text="@string/complete_title"
+                android:textColor="@color/dc_on_hero"
+                android:textSize="26sp"
+                android:textStyle="bold" />
+
+            <TextView
+                android:id="@+id/complete_subtitle"
+                android:layout_width="wrap_content"
+                android:layout_height="wrap_content"
+                android:layout_marginTop="6dp"
+                android:gravity="center"
+                android:textColor="@color/dc_on_hero_muted"
+                android:textSize="15sp"
+                tools:text="4 people added to your count" />
+        </LinearLayout>
+    </FrameLayout>
+
+    <LinearLayout
+        android:id="@+id/complete_bottom"
+        android:layout_width="match_parent"
+        android:layout_height="wrap_content"
+        android:orientation="vertical"
+        android:paddingHorizontal="18dp"
+        android:paddingTop="18dp"
+        android:paddingBottom="18dp">
+
+        <LinearLayout
+            android:id="@+id/complete_stats"
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:background="@drawable/dc_card"
+            android:orientation="horizontal"
+            android:padding="16dp">
+
+            <LinearLayout
+                android:layout_width="0dp"
+                android:layout_height="wrap_content"
+                android:layout_weight="1"
+                android:gravity="center"
+                android:orientation="vertical">
+
+                <TextView
+                    android:id="@+id/complete_households"
+                    android:layout_width="wrap_content"
+                    android:layout_height="wrap_content"
+                    android:textColor="@color/dc_deep"
+                    android:textSize="28sp"
+                    android:textStyle="bold"
+                    tools:text="12" />
+
+                <TextView
+                    android:layout_width="wrap_content"
+                    android:layout_height="wrap_content"
+                    android:text="@string/main_menu_households_surveyed"
+                    android:textColor="@color/dc_ink_muted"
+                    android:textSize="12sp" />
+            </LinearLayout>
+
+            <View
+                android:layout_width="1dp"
+                android:layout_height="match_parent"
+                android:background="@color/dc_hairline" />
+
+            <LinearLayout
+                android:layout_width="0dp"
+                android:layout_height="wrap_content"
+                android:layout_weight="1"
+                android:gravity="center"
+                android:orientation="vertical">
+
+                <TextView
+                    android:id="@+id/complete_people"
+                    android:layout_width="wrap_content"
+                    android:layout_height="wrap_content"
+                    android:textColor="@color/dc_deep"
+                    android:textSize="28sp"
+                    android:textStyle="bold"
+                    tools:text="47" />
+
+                <TextView
+                    android:layout_width="wrap_content"
+                    android:layout_height="wrap_content"
+                    android:text="@string/main_menu_people_reached"
+                    android:textColor="@color/dc_ink_muted"
+                    android:textSize="12sp" />
+            </LinearLayout>
+        </LinearLayout>
+
+        <TextView
+            android:id="@+id/complete_note"
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:layout_marginTop="12dp"
+            android:background="@drawable/dc_card"
+            android:padding="14dp"
+            android:textColor="@color/dc_ink"
+            android:textSize="14sp"
+            android:visibility="gone"
+            tools:text="Milestone reached: Five homes"
+            tools:visibility="visible" />
+
+        <com.google.android.material.button.MaterialButton
+            android:id="@+id/complete_next"
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:layout_marginTop="16dp"
+            android:background="@drawable/dc_button_primary"
+            android:insetTop="0dp"
+            android:insetBottom="0dp"
+            android:minHeight="52dp"
+            android:stateListAnimator="@null"
+            android:text="@string/complete_next_household"
+            android:textColor="@color/dc_on_hero"
+            android:textStyle="bold"
+            app:backgroundTint="@null" />
+
+        <com.google.android.material.button.MaterialButton
+            android:id="@+id/complete_done"
+            style="?materialButtonOutlinedIconStyle"
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:layout_marginTop="10dp"
+            android:insetTop="0dp"
+            android:insetBottom="0dp"
+            android:minHeight="52dp"
+            android:text="@string/complete_home"
+            android:textColor="@color/dc_deep"
+            android:textStyle="bold"
+            app:cornerRadius="@dimen/dc_radius_button"
+            app:strokeColor="@color/dc_action_mid"
+            app:strokeWidth="1.5dp" />
+    </LinearLayout>
+</LinearLayout>
